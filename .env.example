# Copy to .env (same folder) and fill in. .env is read by docker compose and is git-ignored.
# REQUIRED. Bearer token clients must send: Authorization: Bearer <key>. The server refuses to
# start without it. Generate one:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Linux/macOS: openssl rand -base64 32
LAYA_API_KEY=
# Host directory of the checkpoint, mounted read-only on /models/laya (relative to this folder)
LAYA_MODEL_HOST_DIR=./models/laya
# cpu | cuda | auto
LAYA_DEVICE=cpu
# torch threads for CPU inference, keep <= physical cores
LAYA_THREADS=4
LAYA_MAX_CONCURRENT=16
